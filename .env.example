# Copy to .env and adjust. Values match docker-compose.yml.
PORT=3000
DATABASE_URL=postgres://hookline:hookline@localhost:5432/hookline
REDIS_URL=redis://localhost:6379
# Deliveries the worker sends at once.
WORKER_CONCURRENCY=10
# Optional BullMQ key prefix, shared by the API and the worker. Lets several
# environments use one Redis without taking each other's jobs.
# QUEUE_PREFIX=hookline
